# Copy to .env and adjust for your environment.
#
# Base URL of the backend REST API. Must include the version prefix.
# The backend must allow this frontend's origin in CORS_ORIGINS and run with
# credentials enabled (it does by default) so the httpOnly refresh cookie works.
#
# Local development (backend on :5000, with Vite proxy active in vite.config.ts):
VITE_API_URL=http://localhost:5000/api/v1

# Alternative: local development using Vite dev-server proxy (/api → :5000)
# VITE_API_URL=/api/v1

# Production (same-origin behind the backend's static-serving middleware / nginx):
# VITE_API_URL=/api/v1
